{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypermix/schemas/hypermix-events.v1.schema.json",
  "title": "HyperMix Event Stream",
  "definitions": {
    "event": {
      "type": "object",
      "required": ["sample", "type"],
      "properties": {
        "sample": {"type": "integer", "minimum": 0},
        "type": {
          "enum": [
            "track.enter", "segment.enter", "phrase.enter",
            "transition.start", "transition.switch", "transition.end",
            "drop", "hook", "energy",
            "avatar.motion", "avatar.expression", "avatar.fx",
            "persona.musicLine", "custom"
          ]
        },
        "payload": {"type": "object"}
      }
    }
  },
  "type": "object",
  "required": ["schema", "events"],
  "properties": {
    "schema": {"const": "hypermix.events.v1"},
    "events": {
      "type": "array",
      "items": {"$ref": "#/definitions/event"}
    }
  },
  "additionalProperties": true
}
